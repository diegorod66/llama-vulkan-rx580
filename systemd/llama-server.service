[Unit]
Description=llama-server (Vulkan GPUs)
After=network-online.target
Wants=network-online.target
Documentation=https://github.com/tu-usuario/llama-vulkan-rx580

[Service]
Type=simple
User=llama
EnvironmentFile=/etc/llama-server/llama-server.env
ExecStart=/usr/local/bin/llama-server \
  --model ${MODEL_PATH} \
  --host 0.0.0.0 \
  --port ${PORT} \
  -ngl ${NGL} \
  --split-mode ${SPLIT_MODE} \
  --ctx-size ${CTX_SIZE} \
  --batch-size ${BATCH_SIZE}
Restart=always
RestartSec=10
LimitNOFILE=65536

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=default.target
